# Número comercial de WhatsApp de JOEY, en formato internacional:
# solo dígitos, sin "+", espacios ni guiones. Ejemplo para Colombia: 573001234567
# Sin este valor, el checkout no permite finalizar pedidos.
NEXT_PUBLIC_WHATSAPP_PHONE=573107998131

# URL pública del sitio, sin "/" final. Se usa en metadata, Open Graph y sitemap.
NEXT_PUBLIC_SITE_URL=https://www.ejemplo.com
